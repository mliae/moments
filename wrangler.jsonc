{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moments",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // 一键部署：默认启用 workers.dev 子域名；自定义域名请在 Cloudflare
  // Dashboard → Workers & Pages → moments → Settings → Domains & Routes 绑定
  // （Dashboard 绑定的自定义域名不受部署影响，不会被此处覆盖）
  "workers_dev": true,
  // 区域路由（非 Custom Domain）：边缘按 Host 匹配，把流量交给本 Worker。
  // DNS 由手动管理的灰云 CNAME（→ cloudflare.seeck.cn 优选域名）解析，
  // 因此这里不能用 custom_domain=true（那会锁定橙云记录、无法 CNAME 优选）。
  // 注意：同 pattern 不能与面板的 Custom Domain 并存，部署前需先在面板删除。
  "routes": [
    { "pattern": "jxe.me/*", "zone_name": "jxe.me" },
    { "pattern": "www.jxe.me/*", "zone_name": "jxe.me" }
  ],
  // 静态前端（含 vendor）：命中静态文件直接由 assets 服务，其余请求落到 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 全部路径先进 Worker：HTML 做 SSR，API/媒体走动态处理；
    // 这也让后台秘密入口可设为任意路径（见 settings.normalizeAdminPath），
    // 硬加载时由 index.ts notFound 比对 admin_path 并注入 SSR 信号；其余未知路径回退静态资源。
    "run_worker_first": ["/*"]
  },
  // 自动资源 provisioning（wrangler 4.45+，2025-10-24 起 open beta）：
  // 省略 database_id，部署时按 database_name 自动创建/复用 D1，并在 Worker
  // 启动后由 ensureSchema() 在首次请求时检测并建表（migrations/ 仍保留供
  // wrangler d1 migrations apply 命令使用，二者幂等不冲突）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moments-db",
      "migrations_dir": "migrations"
    }
  ],
  // R2 桶同样按 bucket_name 自动创建；如已存在则复用
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "moments-storage"
    }
  ],
  // Cloudflare Workers AI：评论区 @AI 机器人回复（免费额度内的 @cf/* 托管模型）
  "ai": {
    "binding": "AI"
  },
  // Cron Trigger：每分钟触发一次 scheduled 函数
  // - 可用性监控：按后台「运维」配置的检测间隔（分钟）判断是否执行
  // - QQ Cookie 保活：内部按后台配置的保活间隔判断是否执行
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_NAME": "Moments"
  }
}
